# Copy this file to .env and fill in the required values
# Backend configuration
PORT=5000

# Required: MongoDB connection string (e.g., from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Required: Any random string for signing JWTs
JWT_SECRET=change-me-please

# Optional: OpenWeather API key for weather forecasts
WEATHER_API_KEY=

# Optional: Unsplash access key for higher-quality images
UNSPLASH_ACCESS_KEY=

# Optional: Groq API key for trip planning via LLM
GROQ_API_KEY=

# Optional: Override OSRM routing backend
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_BASE=https://router.project-osrm.org
