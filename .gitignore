# Root gitignore for MyWeb (server + client)

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files (keep secrets out of git)
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Build artifacts
client/build/
coverage/

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.vs/

# TypeScript cache
*.tsbuildinfo

# Misc
*.local

# .NET artifacts (solution exists in repo)
bin/
obj/
